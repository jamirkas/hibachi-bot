# Hibachi Trading Bot — Environment Variables
# Copy to .env and fill in your values:
#   cp .env.example .env

# === REQUIRED ===
HIBACHI_API_KEY=your_api_key_here
HIBACHI_SECRET_KEY=your_secret_key_here
HIBACHI_ACCOUNT_ID=0

# === DASHBOARD (optional) ===
DASHBOARD_PORT=8080
DASHBOARD_TOKEN=
DASHBOARD_HOST=127.0.0.1

# === BINANCE ORACLE (optional) ===
# Set to 1 to enable Binance WebSocket fair price
BINANCE_ORACLE_ENABLED=0
